{
  "name": "volunteeros",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @volunteeros/backend db:generate",
    "db:migrate": "pnpm --filter @volunteeros/backend db:migrate",
    "api:generate": "pnpm --filter @volunteeros/frontend api:generate"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "catalog:"
  }
}
