{
  "name": "@volunteeros/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --env-file .env",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:watch": "vitest",
    "db:generate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "nest build && node --env-file-if-exists=.env dist/db/seed.js",
    "auth:schema": "auth generate --config src/auth/auth.cli.ts --output src/db/schema/auth.ts -y",
    "openapi:export": "nest build && node dist/openapi-export.js && prettier --write openapi.json --log-level warn",
    "email:dev": "email dev --dir src/email/templates --port 3001",
    "email:test": "nest build && node --env-file-if-exists=.env dist/email/send-test-emails.js",
    "ai:eval": "nest build && node --env-file-if-exists=.env dist/ai/evals/run-evals.js",
    "lint": "oxlint --type-aware --deny-warnings src test"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.121",
    "@better-auth/core": "catalog:",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/drizzle": "^0.0.2",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/swagger": "^12.1.2",
    "ai": "7.0.177",
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "express": "^5.3.0",
    "libphonenumber-js": "^1.13.16",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pg-boss": "12.38.2",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "^6.11.16",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.38.1",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.1",
    "@react-email/ui": "^6.11.16",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.0.0",
    "auth": "catalog:",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "typescript": "catalog:",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
