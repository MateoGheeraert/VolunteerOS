NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Neon dev branch (branched from production).
# DATABASE_URL: pooled connection string (host contains -pooler), used by the running app.
# DATABASE_URL_UNPOOLED: direct connection string, used by drizzle-kit for migrations and by the
# job queue and live updates (they need LISTEN/NOTIFY and session locks, which the pooler breaks).
DATABASE_URL=
DATABASE_URL_UNPOOLED=


# Public origin of the Next.js app (the only thing browsers talk to).
APP_URL=http://localhost:3000

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
INTERNAL_API_SECRET=

# console (print emails, the default in development) or resend (send them, the default and only
# option in production). Set to resend locally to receive real emails, e.g. with `pnpm email:test`.
EMAIL_PROVIDER=
# Required when EMAIL_PROVIDER is resend.
RESEND_API_KEY=
# Sender. onboarding@resend.dev works without a verified domain, but only delivers to the
# address of the Resend account. Production needs an address on a verified domain.
EMAIL_FROM=VolunteerOS <onboarding@resend.dev>

# AI agent. Without a key the AI features are off and the app works without suggestions.
# Which model each feature uses is decided in code: src/ai/model-catalog.ts.
OPENAI_API_KEY=
# What one organization may spend on AI per calendar month, in euro cents.
AI_MONTHLY_CAP_CENTS=1000

# File storage: Cloudflare R2 (S3 API). Set all four or none; without them uploads are off.
# Use the volunteeros-dev bucket locally, volunteeros in production. The bucket needs a CORS rule
# that allows PUT from APP_URL (see backend/README.md, "File uploads").
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Background jobs (pg-boss) run in this process. They use DATABASE_URL_UNPOOLED above, because
# the job queue and live updates need a direct connection. Set to off to run none.
JOB_WORKERS=on
